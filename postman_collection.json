{
  "info": {
    "name": "GitHub Profile Analyzer",
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "description": "Pre-built requests for the GitHub Profile Analyzer REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Returns the API health status and current timestamp."
      },
      "response": []
    },
    {
      "name": "Analyze GitHub Profile",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/analyze/torvalds",
          "host": ["{{base_url}}"],
          "path": ["api", "analyze", "torvalds"]
        },
        "description": "Fetches a GitHub user's profile and repos, computes insights (top languages, most-starred repo, total stars), and upserts the record in the database."
      },
      "response": []
    },
    {
      "name": "Get All Profiles (Paginated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/profiles?page=1&limit=10",
          "host": ["{{base_url}}"],
          "path": ["api", "profiles"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        },
        "description": "Returns all stored profiles ordered by analyzed_at DESC with pagination."
      },
      "response": []
    },
    {
      "name": "Get Profile by Username",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/profiles/torvalds",
          "host": ["{{base_url}}"],
          "path": ["api", "profiles", "torvalds"]
        },
        "description": "Returns a single stored profile by GitHub username."
      },
      "response": []
    },
    {
      "name": "Delete Profile",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/profiles/torvalds",
          "host": ["{{base_url}}"],
          "path": ["api", "profiles", "torvalds"]
        },
        "description": "Deletes a stored profile by GitHub username."
      },
      "response": []
    }
  ]
